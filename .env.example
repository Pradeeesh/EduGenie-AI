# Required for Gemini-backed features
GEMINI_API_KEY=your_gemini_api_key_here

# Current Gemini model used by the application
GEMINI_MODEL=gemini-2.5-flash

# Use "gemini" for the simplest setup.
# Use "local" to try MBZUAI/LaMini-Flan-T5-783M for /explain.
EXPLAINER_BACKEND=gemini
LOCAL_EXPLAINER_MODEL=MBZUAI/LaMini-Flan-T5-783M

APP_NAME=EduGenie - Learning Assistant
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=*
